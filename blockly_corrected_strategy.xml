<xml>
  <entry_price_call></entry_price_call>
  <entry_price_put></entry_price_put>
  <last_signal></last_signal>
  <logic>
    <check CALL="true" />
    <current_price>{current_price}</current_price>
    <entry_price>{entry_price_call}</entry_price>
    <if>
      <condition>current_price > entry_price_call</condition>
      <action>do_something_for_CALL</action>
    </if>
    <check CALL="false" />
    <entry_price>{entry_price_put}</entry_price>
    <if>
      <condition>current_price < entry_price_put</condition>
      <action>do_something_for_PUT</action>
    </if>
  </logic>
</xml>